# Base URL of the Express API (Member 3). Leave unset to run the UI on mock data.
# VITE_API_URL=http://localhost:5000/api

# Map tiles. Defaults to keyless OpenStreetMap tiles, which are fine for development.
# For production use a provider with an API key (MapTiler, Stadia, CARTO…), e.g.:
# VITE_MAP_TILES=https://api.maptiler.com/maps/streets-v2/256/{z}/{x}/{y}.png?key=YOUR_KEY
# VITE_MAP_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap contributors
